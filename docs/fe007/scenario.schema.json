{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://school-events.sber-urfu.ru/schemas/v1/scenario.schema.json",
  "title": "ServerNormalizedScenarioPayload",
  "description": "Нормализованный контракт сценария на сервере с прикрепленными статусами достоверности и методической разметкой",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concept",
    "pedagogical_goal",
    "value_direction",
    "pedagogical_mechanism",
    "pedagogical_tasks",
    "expected_outcomes",
    "target_audience",
    "format",
    "stages",
    "roles",
    "activities",
    "materials",
    "props",
    "preparation_checklist",
    "teacher_instructions",
    "cultural_claims"
  ],
  "properties": {
    "concept": { "type": "string", "minLength": 30 },
    "pedagogical_goal": { "type": "string", "minLength": 20 },
    "value_direction": {
      "type": "string",
      "enum": [
        "family",
        "mutual_aid",
        "historical_memory",
        "labor_and_creation",
        "cultural_diversity",
        "civic_responsibility"
      ]
    },
    "pedagogical_mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism_type", "description", "target_activity_title"],
      "properties": {
        "mechanism_type": {
          "type": "string",
          "enum": [
            "family_investigation",
            "team_mutual_support_task",
            "historical_source_analysis",
            "collaborative_creative_product",
            "comparative_cultural_study",
            "civic_community_action"
          ]
        },
        "description": { "type": "string", "minLength": 20 },
        "target_activity_title": { "type": "string", "minLength": 3 }
      }
    },
    "pedagogical_tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personal", "meta_subject", "subject_specific"],
      "properties": {
        "personal": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
        "meta_subject": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
        "subject_specific": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } }
      }
    },
    "expected_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge", "skills", "values"],
      "properties": {
        "knowledge": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
        "skills": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
        "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } }
      }
    },
    "target_audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "age_group",
        "target_grades",
        "participants_count_min",
        "participants_count_max",
        "family_involvement"
      ],
      "properties": {
        "age_group": {
          "type": "string",
          "enum": ["primary_1_4", "basic_5_9", "senior_10_11", "mixed"]
        },
        "target_grades": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 11 }
        },
        "participants_count_min": { "type": "integer", "minimum": 5, "maximum": 500 },
        "participants_count_max": { "type": "integer", "minimum": 5, "maximum": 500 },
        "family_involvement": { "type": "boolean" }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_type", "scale", "total_duration_minutes"],
      "properties": {
        "format_type": {
          "type": "string",
          "enum": ["class_hour", "quest", "quiz", "workshop", "festival", "roundtable"]
        },
        "scale": {
          "type": "string",
          "enum": ["class_level", "all_school", "family_community"]
        },
        "total_duration_minutes": { "type": "integer", "minimum": 20, "maximum": 240 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order_index",
          "title",
          "stage_type",
          "duration_minutes",
          "teacher_actions",
          "student_actions",
          "dialogue_prompts",
          "transition_text"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^stage_[a-z0-9_]+$" },
          "order_index": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 3 },
          "stage_type": {
            "type": "string",
            "enum": [
              "organizational_moment",
              "motivation_introduction",
              "main_interactive_part",
              "practical_task",
              "reflection_summary",
              "ritual_conclusion"
            ]
          },
          "duration_minutes": { "type": "integer", "minimum": 2, "maximum": 120 },
          "teacher_actions": { "type": "string", "minLength": 20 },
          "student_actions": { "type": "string", "minLength": 10 },
          "dialogue_prompts": {
            "type": "array",
            "items": { "type": "string", "minLength": 5 }
          },
          "teacher_tips": { "type": "string" },
          "transition_text": { "type": "string", "minLength": 10 }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_name",
          "description",
          "target_participants",
          "group_size",
          "specific_tasks"
        ],
        "properties": {
          "role_name": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 10 },
          "target_participants": {
            "type": "string",
            "enum": ["students", "teachers", "parents", "guests", "moderators"]
          },
          "group_size": { "type": "integer", "minimum": 1 },
          "specific_tasks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 5 }
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "activity_type",
          "target_stage_id",
          "rules_and_instructions",
          "scoring_or_evaluation"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 3 },
          "activity_type": { "type": "string", "minLength": 3 },
          "target_stage_id": { "type": "string", "pattern": "^stage_[a-z0-9_]+$" },
          "rules_and_instructions": { "type": "string", "minLength": 20 },
          "scoring_or_evaluation": { "type": "string", "minLength": 5 }
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation_slides", "printable_cards", "handouts"],
      "properties": {
        "presentation_slides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slide_number",
              "title",
              "bullet_points",
              "visual_recommendations",
              "speaker_notes"
            ],
            "properties": {
              "slide_number": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 3 },
              "bullet_points": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 3 }
              },
              "visual_recommendations": { "type": "string", "minLength": 5 },
              "speaker_notes": { "type": "string", "minLength": 10 }
            }
          }
        },
        "printable_cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "card_type",
              "title",
              "front_text",
              "back_text",
              "quantity_per_group"
            ],
            "properties": {
              "card_type": { "type": "string", "minLength": 2 },
              "title": { "type": "string", "minLength": 3 },
              "front_text": { "type": "string", "minLength": 5 },
              "back_text": { "type": "string", "minLength": 5 },
              "quantity_per_group": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "handouts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "instructions", "template_content"],
            "properties": {
              "title": { "type": "string", "minLength": 3 },
              "instructions": { "type": "string", "minLength": 10 },
              "template_content": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "props": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_name", "quantity", "is_mandatory", "alternative_if_missing"],
        "properties": {
          "item_name": { "type": "string", "minLength": 2 },
          "quantity": { "type": "string", "minLength": 1 },
          "is_mandatory": { "type": "boolean" },
          "alternative_if_missing": { "type": "string" }
        }
      }
    },
    "preparation_checklist": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timeline_phase",
          "task_description",
          "responsible_person"
        ],
        "properties": {
          "timeline_phase": {
            "type": "string",
            "enum": [
              "two_weeks_before",
              "three_days_before",
              "day_before",
              "hour_before"
            ]
          },
          "task_description": { "type": "string", "minLength": 10 },
          "responsible_person": { "type": "string", "minLength": 3 }
        }
      }
    },
    "teacher_instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "general_safety_rules",
        "methodological_recommendations",
        "adaptation_for_disabilities_or_small_groups"
      ],
      "properties": {
        "general_safety_rules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "methodological_recommendations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "adaptation_for_disabilities_or_small_groups": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "cultural_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_text",
          "culture_name",
          "claimed_origin",
          "claimed_meaning",
          "evidence_records",
          "server_verification_status"
        ],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^claim_[a-z0-9_]+$" },
          "claim_text": { "type": "string", "minLength": 10 },
          "culture_name": { "type": "string", "minLength": 3 },
          "claimed_origin": { "type": "string", "minLength": 5 },
          "claimed_meaning": { "type": "string", "minLength": 5 },
          "server_verification_status": {
            "type": "string",
            "enum": [
              "unverified",
              "verified_authentic",
              "disputed",
              "rejected_fake"
            ],
            "description": "Устанавливается ИСКЛЮЧИТЕЛЬНО бэкендом на основе таблицы cultural_claim_sources."
          },
          "evidence_records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_source_id",
                "source_title",
                "citation_locator",
                "verification_status",
                "verified_at"
              ],
              "properties": {
                "event_source_id": { "type": "string", "format": "uuid" },
                "source_title": { "type": "string" },
                "citation_locator": { "type": "string" },
                "verification_status": {
                  "type": "string",
                  "enum": ["unverified", "verified_authentic", "disputed", "rejected_fake"]
                },
                "verified_by": { "type": "string" },
                "verified_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "server_verification_status": { "const": "verified_authentic" } } },
            "then": {
              "properties": {
                "evidence_records": { "minItems": 1 }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "value_direction": { "const": "family" } } },
      "then": {
        "properties": {
          "pedagogical_mechanism": {
            "properties": {
              "mechanism_type": { "const": "family_investigation" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "value_direction": { "const": "mutual_aid" } } },
      "then": {
        "properties": {
          "pedagogical_mechanism": {
            "properties": {
              "mechanism_type": { "const": "team_mutual_support_task" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "value_direction": { "const": "historical_memory" } } },
      "then": {
        "properties": {
          "pedagogical_mechanism": {
            "properties": {
              "mechanism_type": { "const": "historical_source_analysis" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "value_direction": { "const": "labor_and_creation" } } },
      "then": {
        "properties": {
          "pedagogical_mechanism": {
            "properties": {
              "mechanism_type": { "const": "collaborative_creative_product" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "value_direction": { "const": "cultural_diversity" } } },
      "then": {
        "properties": {
          "pedagogical_mechanism": {
            "properties": {
              "mechanism_type": { "const": "comparative_cultural_study" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "value_direction": { "const": "civic_responsibility" } } },
      "then": {
        "properties": {
          "pedagogical_mechanism": {
            "properties": {
              "mechanism_type": { "const": "civic_community_action" }
            }
          }
        }
      }
    }
  ]
}
